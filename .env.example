# Copy to .env and replace the passwords.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=miniflux

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db/${POSTGRES_DB}?sslmode=disable
RUN_MIGRATIONS=1
LISTEN_ADDR=0.0.0.0:8080

CREATE_ADMIN=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Image to run, from ECR. Tagged with the commit SHA by the pipeline.
MINIFLUX_IMAGE=396608811172.dkr.ecr.eu-west-3.amazonaws.com/app-miniflix:<commit-sha>
